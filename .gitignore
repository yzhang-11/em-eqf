experiments/rtpp_v2_multi_bg_norm_0.2/runs/
experiments/rtpp_v2_multi_bg_split_0.7/runs/

# Generated window caches; raw and processed inputs are retained.
data/*/classifier/
data/*/regressor/
data/*/lstm_regressor/
data/*/rf_classifier/
data/*/cache/

