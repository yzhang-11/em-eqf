.DS_Store

# Ignore all experiment subdirectories by default. Only the four published
# ETAS/RTPP multi-dataset result sets below are included in this branch.
experiments/*
!experiments/etas_multi_ds_bg_norm_0.2/
!experiments/etas_multi_ds_bg_norm_0.2/**
!experiments/etas_multi_ds_bg_split_0.7/
