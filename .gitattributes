# Large source snapshots belong in LFS, not the Git object history.
data/**/*.zip filter=lfs diff=lfs merge=lfs -text
data/**/*.catalog filter=lfs diff=lfs merge=lfs -text
data/**/*.parquet filter=lfs diff=lfs merge=lfs -text

# Portable external source snapshots; generated caches are excluded from the bundle.
